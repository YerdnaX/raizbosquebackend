PORT=3000

# Base de datos SQL Server
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_password_sql
DB_SERVER=tiusr15pl.cuc-carrera-ti.ac.cr
DB_DATABASE=tiusr15pl_RaicesCafeVivero
DB_PORT=1433

# Gmail API (OAuth2) — para envío de correos desde Render
# Ver guía de configuración en el README del proyecto
GMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=tu_correo@gmail.com

# Timeout para el envío de correo (ms)
EMAIL_TIMEOUT_MS=25000

# =============================================================================
# AUTENTICACIÓN EN DOS FACTORES (2FA)
# =============================================================================
# Clave AES-256-GCM para cifrar los secretos TOTP en la base de datos.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser exactamente 64 caracteres hexadecimales (32 bytes).
# NUNCA subir el valor real al repositorio.
TWO_FACTOR_ENCRYPTION_KEY=reemplazar_con_64_caracteres_hex

# APIs fake de socios comerciales
PROVEDOR_VIVERO_API_URL=http://localhost:8001
PROVEDOR_PRODUCTOS_API_URL=http://localhost:8002
PROVEDOR_ENTREGAS_API_URL=http://localhost:8003
PROVEDOR_CUPONES_API_URL=http://localhost:8004
PROVEDOR_BANCO_API_URL=http://localhost:8005

# =============================================================================
# PAYPAL (SANDBOX) — pago real vía PayPal Orders API v2
# =============================================================================
# Client ID y Secret de la app REST creada en https://developer.paypal.com
# (modo Sandbox). Ver guía en README.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=tu_client_id_sandbox
PAYPAL_CLIENT_SECRET=tu_client_secret_sandbox

# PayPal no redirige de forma confiable a un esquema personalizado (raizbosque://,
# exp://) directamente desde su pagina de checkout. Por eso estas URLs deben ser
# HTTPS reales (la URL publica de ESTE backend en Render). Esa pagina intermedia
# rebota hacia el deep link real de la app, que la app misma envia en cada
# peticion (varia segun si corre en Expo Go o en un build standalone).
PAYPAL_RETURN_URL=https://tu-backend.onrender.com/api/compras/paypal/retorno
PAYPAL_CANCEL_URL=https://tu-backend.onrender.com/api/compras/paypal/cancelado
